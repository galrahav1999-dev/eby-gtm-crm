# =====================================================================
# EBY GTM CRM — environment variables
#
# 1. Copy this file to `.env.local`
# 2. Fill in the two Supabase values (see docs/SETUP.md, step 2)
# =====================================================================

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon public" API key (safe to expose to the browser;
# Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Mapbox token, only needed for the geography/map view.
# The app works fully without it.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- AI logger (optional) ---
# Required for AI extraction of records from notes/transcripts.
ANTHROPIC_API_KEY=
# Optional model override (defaults to a strong, cost-balanced Claude model).
ANTHROPIC_MODEL=
# Required only to transcribe uploaded call recordings (speech-to-text).
OPENAI_API_KEY=
